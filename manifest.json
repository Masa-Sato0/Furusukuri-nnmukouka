{
  "manifest_version": 3,
  "name": "Fullscreen Web Search",
  "version": "1.0.0",
  "description": "許可したサイトのFullscreen API表示を維持したままBrave Searchで検索します。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": ["https://api.search.brave.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Fullscreen Web Search", "default_popup": "popup.html"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "commands": {
    "toggle-search": {
      "suggested_key": {"default": "Ctrl+Shift+Y", "chromeos": "Ctrl+Shift+Y"},
      "description": "検索パネルを開く / 閉じる"
    }
  },
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
